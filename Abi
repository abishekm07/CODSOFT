-- Drop tables if already exist
DROP TABLE IF EXISTS sales_january;
DROP TABLE IF EXISTS sales_february;

-- Create January table
CREATE TABLE sales_january (
    name VARCHAR(50),
    city VARCHAR(50),
    value INT
);

-- Create February table
CREATE TABLE sales_february (
    name VARCHAR(50),
    city VARCHAR(50),
    value INT
);

