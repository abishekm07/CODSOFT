-------------------------------------------------------
-- 1. UNION (Removes duplicates)
-------------------------------------------------------
SELECT name, city, value FROM sales_january
UNION
SELECT name, city, value FROM sales_february;

-------------------------------------------------------
-- 2. UNION ALL (Keeps duplicates)
-------------------------------------------------------
SELECT name, city, value FROM sales_january
UNION ALL
SELECT name, city, value FROM sales_february;

-------------------------------------------------------
-- 3. EXISTS (Common records in both months)
-------------------------------------------------------
SELECT name, city, value
FROM sales_january j
WHERE EXISTS (
    SELECT 1
    FROM sales_february f
    WHERE f.name = j.name
    AND f.city = j.city
    AND f.value = j.value
);

-------------------------------------------------------
-- 4. NOT EXISTS (Only in January, not in February)
-------------------------------------------------------
SELECT name, city, value
FROM sales_january j
WHERE NOT EXISTS (
    SELECT 1
    FROM sales_february f
    WHERE f.name = j.name
    AND f.city = j.city
    AND f.value = j.value
);
