/* 1. CLEANUP */
DROP TABLE IF EXISTS sales_audit_log;
DROP VIEW IF EXISTS sales_comparison_summary;
DROP TABLE IF EXISTS jan_month_sales_data;
DROP TABLE IF EXISTS feb_month_sales_data;

/* 2. TABLE CREATION */

CREATE TABLE jan_month_sales_data (
    name VARCHAR(50),
    city VARCHAR(50),
    values_amount DECIMAL(10,2)
);

CREATE TABLE feb_month_sales_data (
    name VARCHAR(50),
    city VARCHAR(50),
    values_amount DECIMAL(10,2)
);

CREATE TABLE sales_audit_log (
    log_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50),
    old_value DECIMAL(10,2),
    new_value DECIMAL(10,2),
    changed_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

/* 3. INSERT DATA */

INSERT INTO jan_month_sales_data VALUES
('Alice','New York',1000),
('Bob','London',1500),
('Charlie','Paris',1200);

INSERT INTO feb_month_sales_data VALUES
('Alice','New York',1000),
